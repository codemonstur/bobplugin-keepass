<project>
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.codemonstur</groupId>
    <artifactId>bobplugin-keepass</artifactId>
    <version>4</version>

    <name>${project.groupId}:${project.artifactId}</name>
    <description>A bob plugin that loads variables from a keepass archive.</description>
    <url>https://github.com/codemonstur/bobplugin-keepass</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/codemonstur/bobplugin-keepass.git</connection>
        <developerConnection>scm:git:ssh://github.com:codemonstur/bobplugin-keepass.git</developerConnection>
        <url>https://github.com/codemonstur/bobplugin-keepass/tree/master</url>
        <tag>HEAD</tag>
    </scm>

    <developers>
        <developer>
            <id>codemonstur</id>
            <name>Jurgen Voorneveld</name>
            <email>jegvoorneveld@gmail.com</email>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <maven.compiler.release>17</maven.compiler.release>

        <maven.version>[3.6.3,)</maven.version>

        <version.library.bobthebuildtool>12</version.library.bobthebuildtool>
        <version.library.junit>6.1.3</version.library.junit>
        <version.library.keepassjava2>2.2.6</version.library.keepassjava2>
        <version.library.openkeepass>0.8.2</version.library.openkeepass>

        <version.plugin.check-cves>1.2.0</version.plugin.check-cves>
        <version.plugin.check-license>1.5.0</version.plugin.check-license>
        <version.plugin.codegrade>0.2.0</version.plugin.codegrade>
        <version.plugin.enforcer>3.6.3</version.plugin.enforcer>
        <version.plugin.jar>3.5.1</version.plugin.jar>
        <version.plugin.shade>3.6.2</version.plugin.shade>
        <version.plugin.surefire>3.6.0</version.plugin.surefire>
            <version.library.pitest-junit5>1.2.3</version.library.pitest-junit5>
        <version.plugin.pitest>1.30.1</version.plugin.pitest>
        <!-- default for @{argLine}; jacoco's prepare-agent appends the agent when it runs -->
        <argLine></argLine>
            <version.plugin.jacoco>0.8.15</version.plugin.jacoco>
    </properties>

    <dependencies>

        <dependency>
            <groupId>com.github.codemonstur</groupId>
            <artifactId>bobthebuildtool</artifactId>
            <version>${version.library.bobthebuildtool}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>de.slackspace</groupId>
            <artifactId>openkeepass</artifactId>
            <version>${version.library.openkeepass}</version>
        </dependency>

        <dependency>
            <groupId>org.linguafranca.pwdb</groupId>
            <artifactId>KeePassJava2</artifactId>
            <version>${version.library.keepassjava2}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${version.library.junit}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${version.plugin.jacoco}</version>
                <executions>
                    <execution>
                        <id>pre-unit-test</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>post-unit-test</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>


            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${version.plugin.enforcer}</version>
                <executions>
                    <execution>
                        <id>enforce-maven-version</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireMavenVersion>
                                    <version>${maven.version}</version>
                                    <message>This project requires Maven ${maven.version} to build</message>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${version.plugin.surefire}</version>
                            <configuration>
                    <argLine>@{argLine} -Xshare:off</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${version.plugin.jar}</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Bob-Plugin-Class>keepass.BobPlugin</Bob-Plugin-Class>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${version.plugin.shade}</version>
                <executions>
                    <execution>
                        <id>shade</id>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>${project.artifactId}</finalName>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <manifestEntries>
                                        <Bob-Plugin-Class>keepass.BobPlugin</Bob-Plugin-Class>
                                    </manifestEntries>
                                </transformer>
                            </transformers>
                            <minimizeJar>false</minimizeJar>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <profiles>

        <profile>
            <id>licenses</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>maven-check-license</artifactId>
                        <version>${version.plugin.check-license}</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includeTestDependencies>true</includeTestDependencies>
                            <rules>
                                <rule>name:regex:.*Apache.*</rule>
                                <rule>name:regex:.*BSD.*</rule>
                                <rule>name:regex:.*Eclipse.*</rule>
                                <rule>name:regex:.*GPL.*</rule>
                                <rule>name:regex:.*CDDL.*</rule>
                                <rule>name:regex:.*EDL.*</rule>
                                <rule>name:regex:.*Bouncy Castle.*</rule>
                            </rules>
                        
                        
                            <ignored>
                                <ignored>xpp3:xpp3:*</ignored>
                                <ignored>stax:stax:*</ignored>
                            </ignored>
                        </configuration>
                    </plugin>

                </plugins>
            </build>
        </profile>

        <profile>
            <id>vulnerabilities</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>maven-check-cves</artifactId>
                        <version>${version.plugin.check-cves}</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includeTestDependencies>true</includeTestDependencies>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>codequality</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>com.github.codemonstur</groupId>
                        <artifactId>codegrade-maven-plugin</artifactId>
                        <version>${version.plugin.codegrade}</version>
                        <executions>
                            <execution>
                                <phase>verify</phase>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>

            <profile>
            <id>mutation</id>
            <activation>
                <activeByDefault>false</activeByDefault>
            </activation>
            <build>
                <plugins>

                    <plugin>
                        <groupId>org.pitest</groupId>
                        <artifactId>pitest-maven</artifactId>
                        <version>${version.plugin.pitest}</version>
                        <dependencies>
                            <dependency>
                                <groupId>org.pitest</groupId>
                                <artifactId>pitest-junit5-plugin</artifactId>
                                <version>${version.library.pitest-junit5}</version>
                            </dependency>
                        </dependencies>
                        <executions>
                            <execution>
                                <phase>test</phase>
                                <goals>
                                    <goal>mutationCoverage</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>
</profiles>

</project>
